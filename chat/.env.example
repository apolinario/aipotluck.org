# AI Potluck chat — environment template.
# Copy to .env.local for local dev (gitignored); set these in the Vercel
# project's Environment Variables for a deploy. REQUIRED unless marked optional.

# --- Auth (Auth.js / NextAuth) ---
# Random secret. Generate: `openssl rand -base64 32`
AUTH_SECRET=

# --- Model (open-source inference) ---
# The chat serves ONLY open models. Tokens are server-side only — never ship
# them to the client, never log them.
#
# Serving path: DEFAULT is the HuggingFace router (proven, reliable — what ships
# unless you flip the switch). To cut over to Public AI's own sovereign endpoint,
# set SERVING_PROVIDER=publicai and provide PUBLICAI_API_KEY. Leave it unset (or
# anything other than "publicai") to stay on HF — that's the fallback.
SERVING_PROVIDER=

# HF path (default). https://huggingface.co/settings/tokens
HF_TOKEN=
# Served model id (everything user-facing derives from this).
HF_MODEL=swiss-ai/Apertus-70B-Instruct-2509
# OpenAI-compatible router base URL (default is fine).
HF_BASE_URL=https://router.huggingface.co/v1

# Sovereign path (only used when SERVING_PROVIDER=publicai). The api.publicai.co
# endpoint expects the LOWERCASE model id.
PUBLICAI_API_KEY=
PUBLICAI_MODEL=swiss-ai/apertus-70b-instruct
PUBLICAI_BASE_URL=https://api.publicai.co/v1

# --- Client-exposed config (NEXT_PUBLIC_*; inlined into the browser bundle) ---
# Target of the onboarding overlay's "See the ecosystem" CTA — the gap-map
# Explorer at the site root, OUTSIDE this chat's /chat basePath. Default "/app".
# Opened in a new tab so it doesn't pull the visitor out of the chat.
NEXT_PUBLIC_ECOSYSTEM_URL=/app

# --- Database (Postgres via Drizzle; Neon recommended) ---
# Use a DEDICATED database for this app — do not point at another project's DB.
# Migrations run at build time (`tsx lib/db/migrate && next build`).
POSTGRES_URL=

# --- Optional ---
# Redis enables the rate limiters (per-IP, global daily cap, contribution cap).
# Without it they fail OPEN (logged) — the per-user DB message cap still applies.
REDIS_URL=
# Protects the daily retention cron (/api/cron/retention). Set a random value;
# Vercel sends it as a Bearer on scheduled invocations.
CRON_SECRET=
# Aggregate daily inference budget ceiling (all users). Tune to spend. Default 5000.
GLOBAL_DAILY_REQUEST_CAP=
# Vercel Blob token — ONLY needed if file upload is enabled (it's off for the alpha).
BLOB_READ_WRITE_TOKEN=
# Password gate (HTTP Basic Auth). The gate fires whenever this is SET (on any
# deployment); remove it to open the app to the public. Share "any user / <value>".
PREVIEW_PASSWORD=
