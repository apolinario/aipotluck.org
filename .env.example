OSO_API_KEY=oso_your_api_key_here

# optional tokens for external data sources
GITHUB_TOKEN=your_github_token_here
HF_TOKEN=your_hf_token_here

# --- RAG stores (auto-router) ---
# Master gate for the catalog + federated RAG grounding. Empty/unset = off.
RAG_ENABLED=true
# Local Tier-A vector store: embeds via HF Inference feature-extraction (the HF
# router /v1 has no /embeddings). Auth reuses OPENAI_API_KEY / HF_TOKEN.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference/models
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
# Optional model-driven source classifier when heuristics are ambiguous (off by default).
RAG_CLASSIFIER_ENABLED=

# --- OpenMined SyftHub (federated RAG) ---
# Create a token at https://syfthub.openmined.org -> Settings -> API Token, and a
# testnet wallet (Settings -> Wallet) for the paid EPFL endpoint (pay=true).
SYFTHUB_API_TOKEN=
SYFTHUB_BASE_URL=https://syfthub.openmined.org
# Email used for the data source's visibility/policy checks. Falls back to the
# signed-in user's email when present.
SYFTHUB_USER_EMAIL=
# EPFL News publisher endpoint (semantic retrieval; returns cited snippets).
SYFTHUB_EPFL_ENDPOINT_URL=http://20.0.5.93:8081
SYFTHUB_EPFL_SLUG=epfl-news
SYFTHUB_EPFL_OWNER=epfl-news
# Local-culture vault (federated agent that synthesizes private canton data).
SYFTHUB_VAULT_MODEL=irina11/test-user-data