# .env.ci — CI type-scaffold for svelte-check (npm run check), NOT runtime config.
# svelte-kit sync narrows $env/dynamic/* (hence the config ConfigProxy type) to the
# KEYS present here. Values are intentionally empty: only key presence matters for
# typechecking and CI never runs the server, so no real config or secrets belong here.
# Add a new config.X key in code -> add KEY= here, or CI's typecheck will fail.

ADMIN_API_SECRET=
ADMIN_CLI_LOGIN=
ADMIN_TOKEN=
ALLOWED_USER_DOMAINS=
ALLOWED_USER_EMAILS=
ALLOW_IFRAME=
ALLOW_INSECURE_COOKIES=
